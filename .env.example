# Stripe (test or live keys from https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=sk_live_...
# Signing secret for the webhook endpoint you create at
# https://dashboard.stripe.com/webhooks pointing to /api/webhook
# (listen for the "checkout.session.completed" event)
STRIPE_WEBHOOK_SECRET=whsec_...

# Resend (https://resend.com/api-keys) — used to email the full report
RESEND_API_KEY=re_...
# Must be a verified sender/domain in your Resend account
EMAIL_FROM="VerbRea <results@yourdomain.com>"
# Optional: BCC-style notification of each paid completion
SALES_NOTIFY_EMAIL=you@yourdomain.com

# Public site URL used for Stripe redirect URLs and email links
NEXT_PUBLIC_SITE_URL=https://verb-rea.vercel.app
